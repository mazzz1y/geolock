{
  "manifest_version": 3,
  "name": "GeoLock",
  "version": "1.0.0",
  "description": "Per-page request firewall with geoip, geosite, domain regex, and IP range rules",
  "browser_specific_settings": {
    "gecko": {
      "id": "{8cdee28a-48ed-4f3b-af37-9867998f830e}",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "webNavigation",
    "storage",
    "alarms",
    "dns"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["worker.js"],
    "type": "module"
  },
  "options_ui": {
    "page": "data/options/index.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "data/icons/icon-48.png",
    "96": "data/icons/icon-96.png",
    "128": "data/icons/icon-128.png"
  }
}
